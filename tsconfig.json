{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@dnd-mapp/config-typescript/base.json",
    "include": ["scripts", "src"],
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "lib": ["ES2025"],
        "module": "nodenext",
        "noEmit": true,
        "rewriteRelativeImportExtensions": true,
        "target": "es2024",
        "types": ["node"]
    }
}
